{
  "info": {
    "name": "Neo-Watch API",
    "description": "Complete API collection for Neo-Watch - Near Earth Object Monitoring Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        },
        {
          "name": "Send Verification Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/send-verification",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "send-verification"]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"verify-user-id-timestamp\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "verify-email"]
            }
          }
        }
      ]
    },
    {
      "name": "NEO Feed",
      "description": "Near Earth Object data endpoints",
      "item": [
        {
          "name": "Get Today's Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/neo/feed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "neo", "feed"]
            }
          }
        },
        {
          "name": "Get Feed by Date Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/neo/feed?start_date=2026-02-01&end_date=2026-02-07",
              "host": ["{{baseUrl}}"],
              "path": ["api", "neo", "feed"],
              "query": [
                {
                  "key": "start_date",
                  "value": "2026-02-01"
                },
                {
                  "key": "end_date",
                  "value": "2026-02-07"
                }
              ]
            }
          }
        },
        {
          "name": "Get NEO Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/neo/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "neo", "stats"]
            }
          }
        },
        {
          "name": "Browse All Asteroids",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/neo/browse?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "neo", "browse"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Lookup Asteroid",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/neo/lookup/3542519",
              "host": ["{{baseUrl}}"],
              "path": ["api", "neo", "lookup", "3542519"]
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "description": "User profile and watchlist management",
