{
	"name": "neo-watch-backend",
	"version": "1.0.0",
	"description": "Backend API for Neo-Watch - Near Earth Object Monitoring Platform",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"start": "bun run src/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@elysiajs/bearer": "^1.4.3",
		"@elysiajs/cookie": "^0.8.0",
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/jwt": "^1.4.0",
		"@elysiajs/swagger": "^1.3.1",
		"@types/node-cron": "^3.0.11",
		"bcryptjs": "^3.0.3",
		"drizzle-orm": "^0.45.1",
		"elysia": "^1.4.22",
		"node-cron": "^4.2.1",
		"postgres": "^3.4.8",
		"socket.io": "^4.8.3"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"bun-types": "^1.3.8",
		"drizzle-kit": "^0.31.8",
		"typescript": "^5.9.3"
	},
	"module": "src/index.ts",
	"type": "module"
}
